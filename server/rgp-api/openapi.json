        "schema": {
          "type": "integer",
          "example": 2026
        }
      },
      "FilterType": {
        "name": "type",
        "in": "query",
        "required": false,
        "description": "Libellé (PVEJ, PVEJST, PVRA, PVRJ) ou id.",
        "schema": {
          "type": "string"
        }
      },
      "FilterUnite": {
        "name": "unite",
        "in": "query",
        "required": false,
        "description": "Code unité.",
        "schema": {
          "type": "integer"
        }
      },
      "FilterAnnee": {
        "name": "annee",
        "in": "query",
        "required": false,
