          "example": "15127/1/2026"
        }
      },
      "NumeroQuery": {
        "name": "numero",
        "in": "query",
        "required": false,
        "description": "Soit l'UNA complète unite/numero/annee (si elle contient /), soit le numéro seul (à combiner avec unite et annee).\n",
        "schema": {
          "type": "string",
          "example": "15127/1/2026"
        }
      },
      "Unite": {
        "name": "unite",
