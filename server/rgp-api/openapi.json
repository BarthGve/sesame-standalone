          }
        ],
        "responses": {
          "200": {
            "description": "Procédure trouvée.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Procedure"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "post": {
        "tags": [
          "Procédures"
        ],
        "summary": "Alias de POST /procedure",
        "description": "Alloue numero = MAX(numero) + 1 pour le couple (unite, annee) de façon atomique. Le type peut être un libellé (ex. PVEJ) ou un id.\n",
        "operationId": "createPv",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProcedureCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Procédure créée ; numéro alloué.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Procedure"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/procedures": {
      "get": {
        "tags": [
          "Procédures"
        ],
        "summary": "Lister / filtrer les procédures",
        "description": "Renvoie { data: [ ... ] } : enregistrements correspondant aux filtres.\n",
        "operationId": "listProcedures",
        "parameters": [
          {
            "$ref": "#/components/parameters/FilterType"
