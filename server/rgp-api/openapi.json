            "description": "unite/numero/annee"
          },
          {
            "name": "una_id",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Succès.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/objets/recherche": {
      "get": {
        "tags": [
          "Perquisitions"
        ],
        "summary": "Recoupement d'objets saisis par identifiant fort",
        "operationId": "searchObjets",
        "parameters": [
          {
            "name": "identifiant",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "immatriculation, VIN, IMEI… (normalisé)"
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "filtre optionnel: IMMATRICULATION, VIN, NUMERO_MOTEUR, BIC, IMEI, SIM, MSISDN, NUMERO_SERIE_ARME, NUMERO_DOCUMENT, NUMERO_COMPTE, NUMERO_SERIE"
          }
        ],
        "responses": {
          "200": {
            "description": "Succès.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/perquisition/objets": {
      "post": {
        "tags": [
          "Perquisitions"
        ],
        "summary": "Ajouter des objets à une perquisition existante",
        "operationId": "addObjets",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "perquisition_id",
                  "objets"
                ],
                "properties": {
                  "perquisition_id": {
                    "type": "integer"
                  },
                  "objets": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Perquisition à jour (ou erreur en enveloppe {error}).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object"
                    },
                    "error": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/perquisition/objet/update": {
      "post": {
        "tags": [
          "Perquisitions"
        ],
        "summary": "Mettre à jour un objet saisi existant",
        "operationId": "updateObjet",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Mise à jour partielle. objet_id seul est requis. Le descriptif (categorie, sous_type, numero_scelle, situation, lieu) n'est mis à jour que si categorie est fourni ; champs/identifiants ne sont remplacés que si champs est fourni ([] = vidé) ; l'estimation (colonnes estim_* + sources/hypotheses) n'est reconstruite que si estimation est fournie. photo_url reste toujours inchangé.",
                "required": [
                  "objet_id"
                ],
                "properties": {
                  "objet_id": {
                    "type": "integer"
                  },
                  "categorie": {
                    "type": "string"
                  },
                  "sous_type": {
                    "type": "string"
                  },
                  "numero_scelle": {
                    "type": "string"
                  },
                  "situation": {
                    "type": "string"
                  },
                  "lieu": {
                    "type": "string"
                  },
                  "champs": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "estimation": {
                    "type": "object",
                    "description": "Estimation de valeur (forme camelCase, identique à insertObjets). Si présente, écrase les colonnes estim_* et reconstruit les tables sources/hypotheses.",
                    "properties": {
                      "prixBas": {
                        "type": "number",
                        "description": "Borne basse de la fourchette de prix (-> estim_prix_bas)."
                      },
                      "prixMoyen": {
                        "type": "number",
                        "description": "Prix moyen estimé (-> estim_prix_moyen)."
                      },
                      "prixHaut": {
                        "type": "number",
                        "description": "Borne haute de la fourchette de prix (-> estim_prix_haut)."
                      },
                      "devise": {
                        "type": "string",
                        "description": "Devise ISO, ex. EUR (-> estim_devise)."
                      },
                      "confiance": {
                        "type": "number",
                        "description": "Indice de confiance 0-1 (-> estim_confiance)."
                      },
                      "avertissement": {
                        "type": "string",
                        "description": "Avertissement recopié tel quel depuis la cote (-> estim_avertissement)."
                      },
                      "sources": {
                        "type": "array",
                        "description": "Sources de cote (-> table objet_estimation_source, dans l'ordre).",
                        "items": {
                          "type": "object",
                          "properties": {
                            "site": {
                              "type": "string"
                            },
                            "url": {
                              "type": "string"
                            },
                            "prix": {
                              "type": "number"
                            }
                          }
                        }
                      },
                      "hypotheses": {
                        "type": "array",
                        "description": "Hypothèses de cote (-> table objet_estimation_hypothese, dans l'ordre).",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Perquisition à jour (ou erreur {error}).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object"
                    },
                    "error": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/perquisition/objet/delete": {
      "post": {
        "tags": [
          "Perquisitions"
        ],
        "summary": "Supprimer un objet saisi",
        "operationId": "deleteObjet",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "objet_id"
                ],
                "properties": {
                  "objet_id": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Perquisition à jour (ou erreur {error}).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object"
                    },
                    "error": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/procedure/creer": {
      "get": {
        "tags": [
          "Procedures"
        ],
        "summary": "Allouer un numero de procedure (variante GET)",
        "description": "Identique a POST /procedure mais parametres en query. Contournement du bug dIAka sur les requetes POST : a privilegier pour la creation depuis un agent.",
        "operationId": "creer_procedure",
        "parameters": [
          {
            "name": "unite",
            "in": "query",
            "required": true,
            "description": "Code unité.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": true,
            "description": "Libellé (ex. PVEJ) ou id du type de document.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "synthese",
            "in": "query",
            "required": false,
            "description": "Synthèse / objet de la procédure (ex. « cambriolage »). Optionnel.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "commune",
            "in": "query",
            "required": false,
            "description": "Commune du fait : nom (ex. « Candé ») ou code INSEE. Résolue côté API. Optionnel.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type_lieu",
            "in": "query",
            "required": false,
            "description": "Type de lieu du fait (cambriolage / vol par effraction), déduit par l'agent. Valeurs : LOCAL_PRO, HABITATION, LIEU_PUBLIC, VEHICULE, INDETERMINE. Ex. boulangerie / pharmacie / SARL / tout nom en -erie -> LOCAL_PRO ; domicile -> HABITATION. Optionnel ; valeur hors liste ignorée. (Sans enum : le bridge openapi->MCP d'IAka échoue au démarrage sur un enum.)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "adresse",
            "in": "query",
            "required": false,
            "description": "Adresse littérale du fait si présente (n°, rue). Optionnel ; ne pas inventer.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "urgent",
            "in": "query",
            "required": false,
            "description": "Procédure urgente. Optionnel ; non précisé = false.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "sensible",
            "in": "query",
            "required": false,
            "description": "Procédure sensible. Optionnel ; non précisé = false.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "groupe",
            "in": "query",
            "required": false,
            "description": "Libellé ou id de groupe, scopé à l'unité. Optionnel.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "annee",
            "in": "query",
            "required": false,
            "description": "Optionnel ; défaut = année courante.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Procedure creee ; numero alloue.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Procedure"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/communes": {
      "get": {
        "tags": [
          "Procedures"
        ],
        "summary": "Rechercher / résoudre une commune",
        "description": "Typeahead commune, insensible aux accents. q numérique (4-5 chiffres) -> filtre code postal ou début de code INSEE ; sinon -> préfixe de nom. Sert à lever une ambiguïté avant création/modification.",
        "operationId": "searchCommunes",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Nom de commune (préfixe) ou code postal.",
            "schema": {
              "type": "string"
            },
            "example": "Segré"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Nombre max de résultats (défaut 20, max 100).",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Communes correspondantes.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code_insee": {
                            "type": "string"
                          },
                          "nom": {
                            "type": "string"
                          },
                          "code_postal": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }
  },
  "components": {
