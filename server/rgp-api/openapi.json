          }
        }
      }
    },
    "/modifier": {
      "post": {
        "tags": [
          "Procédures"
        ],
        "summary": "Modifier un UNA (sauf identité)",
        "description": "Modifie les champs fournis d'un UNA existant. L'identité unite/numero/annee n'est jamais modifiée.\n",
        "operationId": "modifier_procedure",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProcedureUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Procédure modifiée.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Procedure"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/perquisition": {
      "post": {
        "tags": [
          "Perquisitions"
        ],
        "summary": "Créer une perquisition et ses objets saisis",
        "operationId": "createPerquisition",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "adresse",
                  "objets"
                ],
                "properties": {
                  "una": {
                    "type": "string",
                    "description": "unite/numero/annee"
                  },
                  "una_id": {
                    "type": "integer"
                  },
                  "adresse": {
                    "type": "string"
                  },
                  "code_postal": {
                    "type": "string"
                  },
                  "commune": {
                    "type": "string",
                    "description": "code INSEE ou nom"
                  },
                  "latitude": {
                    "type": "number"
                  },
                  "longitude": {
                    "type": "number"
                  },
                  "type_lieu": {
                    "type": "string",
                    "description": "Type de lieu de la perquisition. Valeurs : DOMICILE, LOCAL_PRO, VEHICULE, AUTRE. Valeur hors liste ignoree. (Sans enum : le bridge openapi->MCP dIAka echoue au demarrage sur un enum.)"
                  },
                  "perquisitionne": {
                    "type": "string"
                  },
                  "opj": {
                    "type": "string"
                  },
                  "date_debut": {
                    "type": "string"
                  },
                  "intervenants": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "pieces": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "objets": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "categorie"
                      ],
                      "properties": {
                        "categorie": {
                          "type": "string"
                        },
                        "sous_type": {
                          "type": "string"
                        },
                        "confiance": {
                          "type": "number"
                        },
                        "numero_scelle": {
                          "type": "string"
                        },
                        "situation": {
                          "type": "string",
                          "description": "Situation du scelle. Valeurs : SAISI_SOUS_SCELLE, SAISI_NON_SCELLE. (Sans enum : voir type_lieu.)"
                        },
                        "lieu": {
                          "type": "string"
                        },
                        "photo_url": {
                          "type": "string"
                        },
                        "estimation": {
                          "type": "object"
                        },
                        "champs": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "cle": {
                                "type": "string"
                              },
                              "libelle": {
                                "type": "string"
                              },
                              "valeur": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              },
                              "source": {
                                "type": "string",
                                "description": "Origine du champ. Valeurs : deduit, a_completer. (Sans enum : voir type_lieu.)"
                              },
                              "obligatoire": {
                                "type": "boolean"
                              }
                            }
                          }
                        },
                        "categoriesAlternatives": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Perquisition créée (ou erreur en enveloppe {error}).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object"
                    },
                    "error": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Perquisitions"
        ],
        "summary": "Détail d'une perquisition",
        "operationId": "getPerquisition",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Succès.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/perquisitions": {
      "get": {
        "tags": [
