{
  "openapi": "3.1.0",
  "info": {
    "title": "RGP Lookup API (carnet)",
    "version": "1.0.0-modtest",
    "description": "API HTTP de consultation et d'allocation de procédures RGP par UNA (unite/numero/annee).\nEnveloppe de réponse uniforme : succès { \"data\": ... }, erreur { \"error\": { \"code\": \"...\", \"message\": \"...\" } }.\nUNA = unite/numero/annee. numero est un compteur qui repart à 1 par couple (unite, annee).\n"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Production"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Procédures",
      "description": "Consultation (GET) et allocation (POST) de procédures RGP."
    },
    {
      "name": "Système"
    }
  ],
  "paths": {
    "/procedure": {
      "get": {
        "tags": [
          "Procédures"
        ],
        "summary": "Consulter une procédure par UNA",
        "description": "Fournir SOIT l'UNA complète en chaîne via una (ou ses alias pv / numero, découpée sur /), SOIT les trois composantes séparées unite, numero, annee.\n",
        "operationId": "getProcedure",
        "parameters": [
          {
            "$ref": "#/components/parameters/Una"
          },
          {
            "$ref": "#/components/parameters/Pv"
          },
          {
            "$ref": "#/components/parameters/NumeroQuery"
          },
          {
            "$ref": "#/components/parameters/Unite"
          },
          {
            "$ref": "#/components/parameters/Annee"
          }
        ],
        "responses": {
          "200": {
            "description": "Procédure trouvée.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Procedure"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "post": {
        "tags": [
          "Procédures"
        ],
        "summary": "Allouer un nouveau numéro de procédure",
        "description": "Alloue numero = MAX(numero) + 1 pour le couple (unite, annee) de façon atomique. Le type peut être un libellé (ex. PVEJ) ou un id.\n",
        "operationId": "createProcedure",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProcedureCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Procédure créée ; numéro alloué.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Procedure"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/pv": {
      "get": {
        "tags": [
          "Procédures"
        ],
        "summary": "Alias de GET /procedure",
        "description": "Fournir SOIT l'UNA complète en chaîne via una (ou ses alias pv / numero, découpée sur /), SOIT les trois composantes séparées unite, numero, annee.\n",
        "operationId": "getPv",
        "parameters": [
          {
            "$ref": "#/components/parameters/Una"
