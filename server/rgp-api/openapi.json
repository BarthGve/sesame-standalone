                  "not_found"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "ProcedureUpdate": {
        "type": "object",
        "required": [
          "una"
        ],
        "properties": {
          "una": {
            "type": "string",
            "description": "UNA à modifier (unite/numero/annee). Identité non modifiable.",
            "example": "15127/1/2026"
          },
          "synthese": {
            "type": [
              "string",
              "null"
            ],
            "description": "Nouvelle synthèse."
          },
          "type": {
            "description": "Nouveau type. Libellé (ex. PVEJ) ou id.",
            "oneOf": [
              {
                "type": "string",
                "example": "PVEJ"
              },
              {
                "type": "integer"
              }
            ]
          },
          "groupe": {
            "description": "Nouveau groupe. Libellé (A / Groupe A) ou id.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "urgent": {
            "type": "boolean"
          },
          "sensible": {
            "type": "boolean"
          },
          "nigend_de": {
            "type": [
              "integer",
              "null"
            ]
          },
          "date_limit": {
            "type": [
              "string",
              "null"
            ],
            "description": "Date limite (ISO)."
          },
          "type_lieu": {
            "type": "string",
            "description": "(Ré)attribue le type de lieu du fait (table una_lieu). Valeurs : LOCAL_PRO, HABITATION, LIEU_PUBLIC, VEHICULE, INDETERMINE. Déduit par l'agent depuis la synthèse. Valeur hors liste ignorée. (Sans enum : le bridge openapi->MCP d'IAka échoue au démarrage sur un enum.)",
            "example": "LIEU_PUBLIC"
          },
          "adresse": {
            "type": "string",
            "description": "(Ré)attribue l'adresse littérale du fait (table una_lieu). Optionnel ; ne pas inventer."
          }
        }
      }
