    "schemas": {
      "Procedure": {
        "type": "object",
        "description": "Enregistrement de la table una, enrichi des libellés joints (unite_libelle, type_libelle, groupe_libelle).\n",
        "properties": {
          "id": {
            "type": "integer"
          },
          "unite": {
            "type": "integer",
            "description": "Code unité (FK unite.code).",
            "example": 15127
          },
          "numero": {
            "type": "integer",
            "description": "Compteur par (unite, annee), repart à 1 chaque année.",
            "example": 1
          },
          "annee": {
            "type": "integer",
            "example": 2026
          },
          "synthese": {
            "type": [
              "string",
              "null"
            ]
          },
          "type_document": {
            "type": [
              "integer",
              "null"
            ],
            "description": "FK type_document.id."
          },
          "nigend_de": {
            "type": [
              "integer",
              "null"
            ]
          },
          "urgent": {
            "type": "boolean"
          },
          "sensible": {
            "type": "boolean"
          },
          "groupe": {
            "type": [
              "integer",
              "null"
            ],
            "description": "FK groupe.id."
          },
          "date_limit": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "date_submit": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "unite_libelle": {
            "type": [
              "string",
              "null"
            ],
            "example": "Communauté de brigades de Segré-en-Anjou Bleu"
          },
          "type_libelle": {
            "type": [
              "string",
              "null"
            ],
            "example": "PVEJ"
          },
          "groupe_libelle": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "unite",
          "numero",
          "annee"
        ]
      },
      "ProcedureCreate": {
        "type": "object",
        "required": [
          "unite",
          "type"
        ],
        "properties": {
          "unite": {
            "type": "integer",
            "description": "Code unité.",
            "example": 15127
          },
          "type": {
            "description": "Libellé (ex. PVEJ) ou id du type de document.",
            "oneOf": [
              {
                "type": "string",
                "example": "PVEJ"
              },
              {
                "type": "integer"
              }
            ]
          },
          "synthese": {
            "type": [
              "string",
              "null"
            ],
            "description": "Synthèse / objet de la procédure (ex. « cambriolage »). Optionnel.",
            "example": "cambriolage"
          },
          "commune": {
            "type": "string",
            "description": "Commune du fait : nom (ex. « Candé ») ou code INSEE. Résolue côté API. Optionnel.",
            "example": "Candé"
          },
          "type_lieu": {
            "type": "string",
            "description": "Type de lieu du fait (cambriolage / vol par effraction), déduit par l'agent. Valeurs : LOCAL_PRO, HABITATION, LIEU_PUBLIC, VEHICULE, INDETERMINE. Ex. boulangerie / pharmacie / SARL / tout nom en -erie -> LOCAL_PRO ; domicile -> HABITATION. Optionnel ; valeur hors liste ignorée. (Sans enum : le bridge openapi->MCP d'IAka échoue au démarrage sur un enum.)",
            "example": "LOCAL_PRO"
          },
          "adresse": {
            "type": "string",
            "description": "Adresse littérale du fait si présente (n°, rue). Optionnel ; ne pas inventer.",
            "example": "12 rue des Lilas"
          },
          "urgent": {
            "type": "boolean",
            "default": false,
            "description": "Procédure urgente. Optionnel ; non précisé = false."
          },
          "sensible": {
            "type": "boolean",
            "default": false,
            "description": "Procédure sensible. Optionnel ; non précisé = false."
          },
          "groupe": {
            "description": "Libellé ou id de groupe, scopé à l'unité. Optionnel.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "annee": {
            "type": "integer",
            "description": "Optionnel ; défaut = année courante.",
            "example": 2026
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
